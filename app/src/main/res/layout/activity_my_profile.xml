<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorSurface">

    <!-- Toàn bộ nội dung chính -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- 🧭 Thanh Toolbar có nút quay lại -->
        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/topAppBar"
            style="@style/Widget.Material3.Toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:title="👤 Món ăn chia sẻ"
            app:titleTextColor="@color/colorOnSurface"
            app:navigationIcon="@drawable/ic_arrow_back_24"
            android:background="@color/colorSurface"
            android:elevation="4dp" />

        <!-- Nội dung chính -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:background="@color/colorBackground">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/padding_xlarge">

                <!-- Thông tin user -->
                <TextView
                    android:id="@+id/tvName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Tên người dùng"
                    android:textColor="@color/colorOnSurface"
                    android:textSize="@dimen/text_large"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:layout_marginBottom="@dimen/margin_small" />

                <TextView
                    android:id="@+id/tvEmail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Email"
                    android:textColor="@color/colorMuted"
                    android:textSize="@dimen/text_medium"
                    android:gravity="center"
                    android:layout_marginBottom="@dimen/margin_medium" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/colorOutline"
                    android:layout_marginBottom="@dimen/margin_medium" />

                <!-- Danh sách món đã chia sẻ -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🍽️ Món đã chia sẻ"
                    android:textStyle="bold"
                    android:textColor="@color/colorPrimary"
                    android:textSize="@dimen/text_medium"
                    android:layout_marginBottom="@dimen/margin_normal" />

                <LinearLayout
                    android:id="@+id/layoutSharedFoods"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <!-- ➕ Nút tạo bài chia sẻ mới -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/btnAddPost"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end|bottom"
        android:layout_margin="@dimen/margin_xlarge"
        android:contentDescription="Tạo bài chia sẻ mới"
        android:src="@drawable/ic_add"
        app:backgroundTint="@color/colorPrimary"
        app:tint="@color/colorOnPrimary" />
</FrameLayout>
