<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorSurface"
    android:fillViewport="true">

    <LinearLayout
        android:orientation="vertical"
        android:padding="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Hình ảnh -->
        <ImageView
            android:id="@+id/imgFoodDetail"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:adjustViewBounds="true"
            android:scaleType="centerCrop"
            android:background="@color/colorOutline" />

        <!-- Tên món -->
        <TextView
            android:id="@+id/tvFoodTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Tên món"
            android:textColor="@color/colorPrimary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- Mô tả -->
        <TextView
            android:id="@+id/tvFoodDesc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Mô tả / giới thiệu ngắn"
            android:textColor="@color/colorOnSurface"
            android:layout_marginTop="4dp" />

        <!-- Danh mục -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Danh mục:"
            android:textStyle="bold"
            android:textColor="@color/colorPrimary"
            android:layout_marginTop="12dp"
            android:textSize="16sp"/>
        <TextView
            android:id="@+id/tvCategory"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="..."
            android:layout_marginTop="4dp"
            android:textColor="@color/colorOnSurface"/>
        <!-- Calories -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Calories:"
            android:textStyle="bold"
            android:textColor="@color/colorPrimary"
            android:layout_marginTop="12dp"
            android:textSize="16sp"/>

        <TextView
            android:id="@+id/tvCalories"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0 kcal"
            android:textColor="@color/colorOnSurface"
            android:layout_marginTop="4dp"/>

        <!-- Tags -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tags"
            android:textStyle="bold"
            android:textColor="@color/colorPrimary"
            android:layout_marginTop="12dp"
            android:textSize="16sp"/>
        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupTags"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:chipSpacing="8dp"
            android:layout_marginTop="6dp" />

        <!-- Nguyên liệu -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="12dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Nguyên liệu"
                android:textStyle="bold"
                android:textColor="@color/colorPrimary"
                android:textSize="16sp" />

            <ImageButton
                android:id="@+id/btnAddToShopping"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:padding="6dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_add_shopping"
                android:scaleType="fitCenter"
                android:adjustViewBounds="true"
                app:tint="@color/colorPrimary" />
        </LinearLayout>

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupIngredients"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:chipSpacing="8dp"
            android:layout_marginTop="6dp" />

        <!-- Cách nấu -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Cách nấu"
            android:textStyle="bold"
            android:textColor="@color/colorPrimary"
            android:layout_marginTop="12dp"
            android:textSize="16sp"/>
        <TextView
            android:id="@+id/tvInstructions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/colorOnSurface"
            android:lineSpacingExtra="4dp"
            android:text="..." />

        <!-- YouTube -->
        <LinearLayout
            android:id="@+id/youtubeContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="8dp"
            android:background="@drawable/bg_card_simple"
            android:visibility="gone">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_youtube"
                android:contentDescription="@string/watch_video" />

            <TextView
                android:id="@+id/tvWatchYoutube"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Xem video hướng dẫn"
                android:textColor="@android:color/black"
                android:textSize="16sp" />
        </LinearLayout>

        <!-- ===== Nút hành động ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="16dp">

            <!-- Nút trái tim -->
            <ImageButton
                android:id="@+id/btnFavorite"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_favorite_border"
                android:contentDescription="Yêu thích"
                android:tint="@color/colorPrimary" />

            <!-- Nút nấu ăn -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCook"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginHorizontal="12dp"
                android:text="Nấu ăn"
                android:textAllCaps="false"
                android:textColor="@color/colorPrimary"
                app:cornerRadius="12dp"
                app:strokeColor="@color/colorPrimary"
                app:strokeWidth="2dp"
                app:backgroundTint="@android:color/white" />

            <!-- Nút chia sẻ -->
            <ImageButton
                android:id="@+id/btnShare"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_share"
                android:contentDescription="Chia sẻ"
                android:tint="@color/colorPrimary" />
        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
