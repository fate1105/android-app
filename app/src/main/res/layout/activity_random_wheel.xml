<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorSurface"
    android:padding="16dp">

    <!-- 🔹 Tiêu đề -->
    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="🎲 Quay món ngẫu nhiên"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="@color/colorOnSurface"
        android:gravity="center"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- 🌀 Vòng quay + mũi tên -->
    <FrameLayout
        android:id="@+id/wheelContainer"
        android:layout_width="300dp"
        android:layout_height="300dp"
        app:layout_constraintTop_toBottomOf="@id/tvTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="32dp">

        <!-- Bánh xe -->
        <com.example.angiday.ui.wheels.SpinWheelView
            android:id="@+id/spinWheelView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Mũi tên đứng yên -->
        <ImageView
            android:id="@+id/arrowIndicator"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="top|center_horizontal"
            android:src="@drawable/arrow"
            android:rotation="180"
            android:translationY="-8dp"
            app:tint="@color/colorPrimary" />
    </FrameLayout>

    <!-- 🔘 Nút quay -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSpin"
        style="@style/Widget.MaterialComponents.Button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Quay ngay 🎯"
        android:textSize="18sp"
        android:textStyle="bold"
        android:backgroundTint="@color/colorPrimary"
        android:textColor="@color/white"
        app:cornerRadius="24dp"
        app:layout_constraintTop_toBottomOf="@id/wheelContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="24dp"/>

    <!-- 🍽️ Kết quả -->
    <TextView
        android:id="@+id/tvResult"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Hãy nhấn quay để chọn món!"
        android:textSize="16sp"
        android:textColor="@color/colorOnSurface"
        android:gravity="center"
        app:layout_constraintTop_toBottomOf="@id/btnSpin"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp"/>
</androidx.constraintlayout.widget.ConstraintLayout>
